{
  "name": "gerador-aulas-app",
  "version": "1.0.0",
  "description": "Aplicativo para geração de aulas científicas",
  "main": "index.js",
  "scripts": {
    "build": "npm run copy-assets",
    "copy-assets": "mkdir -p dist && cp -r *.html *.css js/ assets/ dist/",
    "dev": "npx http-server . -p 3000 -o",
    "android": "npx cap run android",
    "sync": "npx cap sync",
    "open-android": "npx cap open android"
  },
  "keywords": [
    "education",
    "science",
    "lesson-generator",
    "android",
    "capacitor"
  ],
  "author": "Gustavo Milani",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^5.5.1",
    "@capacitor/app": "^5.0.6",
    "@capacitor/core": "^5.5.1",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6",
    "@capacitor/share": "^5.0.6",
    "@capacitor/filesystem": "^5.1.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.5.1",
    "typescript": "^5.2.2",
    "http-server": "^14.1.1"
  }
